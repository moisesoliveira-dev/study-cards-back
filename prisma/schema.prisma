generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CardStatus {
  NEW
  REVIEW
  KNOWN
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  username     String      @unique
  passwordHash String
  name         String?
  avatarPath   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  subjects     Subject[]
  flows        FlowBoard[]
  pdfGroups    PdfGroup[]
  pdfDocuments PdfDocument[]

  @@index([email])
  @@index([username])
}

model PdfGroup {
  id          String        @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String        @default("#7C5CFC")
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   PdfDocument[]

  @@index([userId])
  @@index([userId, position])
}

model PdfDocument {
  id           String    @id @default(cuid())
  userId       String
  groupId      String?
  title        String
  originalName String
  storageName  String    @unique
  mimeType     String    @default("application/pdf")
  sizeBytes    Int
  favorite     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group        PdfGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([groupId])
  @@index([userId, groupId])
  @@index([userId, favorite])
}

model Subject {
  id          String      @id @default(cuid())
  userId      String
  name        String
  description String?
  color       String      @default("#BA7517")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  topics      Topic[]
  cards       Card[]
  flows       FlowBoard[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([userId])
}

model FlowBoard {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  name      String
  nodes     Json     @default("[]")
  edges     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subjectId])
  @@index([userId, subjectId])
}

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  parentId    String?
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject  Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent   Topic?  @relation("TopicTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Topic[] @relation("TopicTree")
  cards    Card[]

  @@index([subjectId])
  @@index([parentId])
  @@index([subjectId, parentId])
}

model Card {
  id        String     @id @default(cuid())
  subjectId String
  topicId   String?
  front     String
  back      String
  document  String?    @db.Text
  hint      String?
  icon      String?    @db.Text
  tag       String     @default("Conceito")
  status    CardStatus @default(NEW)
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  subject Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic   Topic?     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sources CardLink[] @relation("MergedFrom")
  usedIn  CardLink[] @relation("MergedInto")

  @@index([subjectId])
  @@index([topicId])
  @@index([subjectId, topicId])
  @@index([status])
}

model CardLink {
  id           String   @id @default(cuid())
  sourceCardId String
  targetCardId String
  createdAt    DateTime @default(now())

  sourceCard Card @relation("MergedInto", fields: [sourceCardId], references: [id], onDelete: Cascade)
  targetCard Card @relation("MergedFrom", fields: [targetCardId], references: [id], onDelete: Cascade)

  @@unique([sourceCardId, targetCardId])
  @@index([sourceCardId])
  @@index([targetCardId])
}
