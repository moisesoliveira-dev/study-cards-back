# Database
DATABASE_URL=postgresql://studycards:studycards@localhost:5432/studycards?schema=public

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Frontend URL (links de e-mail: reset de senha)
APP_URL=http://localhost:5173

# Auth (change in production)
JWT_SECRET=change-me-to-a-long-random-secret
# Sessão padrão (sem “lembrar”) — 1 dia
JWT_EXPIRES_SECONDS=86400
# Sessão com “lembrar do acesso” — 30 dias
JWT_REMEMBER_EXPIRES_SECONDS=2592000

# E-mail via Gmail (obrigatório em produção para cadastro/reset)
# Crie uma "Senha de app" em: https://myaccount.google.com/apppasswords
# (precisa ter verificação em 2 etapas ativada na conta Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=moiseixas123@gmail.com
SMTP_PASS=cole-aqui-a-senha-de-app-de-16-letras
SMTP_FROM=Study Cards <moiseixas123@gmail.com>

# PDF library (use a persistent volume in production)
PDF_STORAGE_PATH=storage/pdfs
