# Database
DATABASE_URL=postgresql://studycards:studycards@localhost:5432/studycards?schema=public

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Auth (change in production)
JWT_SECRET=change-me-to-a-long-random-secret
# Limite absoluto do token sem “lembrar” (a inatividade de 1h é aplicada no cliente)
JWT_EXPIRES_SECONDS=86400
# Sessão com “lembrar do acesso” — 2 dias
JWT_REMEMBER_EXPIRES_SECONDS=172800

# PDF library (use a persistent volume in production)
PDF_STORAGE_PATH=storage/pdfs
